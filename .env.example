# Copy to .env (git-ignored). Everything here is optional.

# Which model answers: "local" (default) or "gemini".
MODEL_PROVIDER=local

# local: any OpenAI-compatible server (LM Studio http://localhost:1234/v1, Ollama http://localhost:11434/v1).
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=local
# LOCAL_LLM_TIMEOUT_MS=180000
# Extra fields for every request, e.g. to switch thinking off: {"chat_template_kwargs":{"enable_thinking":false}}
# LOCAL_LLM_EXTRA_BODY=

# gemini: only used when MODEL_PROVIDER=gemini. The chat then leaves this computer.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# TEMPERATURE=0.3
# MAX_TOKENS=4096

# ACTION_LOG=0 turns the action log off; ACTION_LOG_DIR moves it (default logs/).
